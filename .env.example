# Public URL of the site (used for canonical URLs, sitemap, OpenGraph, JSON-LD). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# ---- Contact details & social profiles (public, shown on the site; redeploy after changing) ----
# Phone as it should be displayed. Also used for tel: links and the JSON-LD telephone.
NEXT_PUBLIC_PHONE=+91 98716 63624
# WhatsApp number with country code (digits; spaces/+ are ignored). Leave blank to use NEXT_PUBLIC_PHONE.
NEXT_PUBLIC_WHATSAPP=
# Public email shown on the site (optional). Not where enquiries go: that's ENQUIRY_TO_EMAIL below.
NEXT_PUBLIC_CONTACT_EMAIL=
# Instagram handle without "@". Leave it out to use the default; set it empty to hide Instagram.
NEXT_PUBLIC_INSTAGRAM=trilochana_photography
# Optional profile URLs. Blank = not shown.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Resend (https://resend.com): the enquiry email
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Trilochana Website <enquiries@yourdomain.com>"
ENQUIRY_FROM_EMAIL=
# Where enquiries go. Comma-separate for several addresses.
ENQUIRY_TO_EMAIL=

# Optional: append every enquiry to a Google Sheet. Leave blank to skip.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON, keeping the \n sequences, in double quotes.
GOOGLE_PRIVATE_KEY=
